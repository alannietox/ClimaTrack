# Entorno
APP_ENV=production
APP_TIMEZONE=Europe/Madrid

# Base de datos
DB_HOST=localhost
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_CHARSET=utf8mb4

# AEMET OpenData
# https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=tu_api_key_aqui

